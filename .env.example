# Canonical public origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.ridesaudi.com

# Quote delivery (server only - NEVER prefix with NEXT_PUBLIC_). Run supabase/quote_requests.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional spam protection (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional analytics (GA4). Loads only after the visitor accepts the consent banner.
NEXT_PUBLIC_GA_ID=
# Optional Search Console verification token (content of the meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# Verified business facts - leave empty until confirmed. Empty values are never rendered or put in schema.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
