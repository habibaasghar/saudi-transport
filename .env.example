# Names only — set real values in the hosting dashboard, never commit them.
NEXT_PUBLIC_SITE_URL=https://www.ridesaudi.com
# Server-side only. Where validated enquiries are POSTed (JSON). If unset, the form
# honestly reports that enquiries are not open yet and nothing is sent anywhere.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the "x-ridesaudi-secret" header to the webhook.
ENQUIRY_WEBHOOK_SECRET=
