# Names only: set real values in the Vercel dashboard (Project -> Settings -> Environment Variables), never commit them.
NEXT_PUBLIC_SITE_URL=https://www.ridesaudi.com

# ---- Where leads go (configure at least one; all can be on at once) ----
# 1) Supabase (stores every lead). Run supabase/enquiries.sql first. SERVER-ONLY secret.
SUPABASE_URL=https://nxparehkrztumdjecint.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 2) Email alert for each lead via Resend (resend.com). LEAD_NOTIFY_EMAIL may be comma-separated.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Optional sender. Default uses Resend's test sender; verify your domain in Resend to use e.g. leads@ridesaudi.com
LEAD_FROM_EMAIL=
# 3) Optional generic webhook (CRM, Zapier, Make)
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=

# ---- Public contact (shown on the site) ----
# Digits with country code, e.g. 9665XXXXXXXX. The "Book on WhatsApp" button appears only when this is set.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=

# ---- CRM (Phase 2) ----
# Supabase pooler connection string (server-only). Direct db.<ref>.supabase.co is IPv6-only; use the pooler host.
DATABASE_URL=
# Supabase Auth (publishable key is safe to expose; it cannot read CRM tables because RLS has no policies)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional salt for hashing visitor IPs stored on inquiries
IP_HASH_SALT=
# Admin notification address (used from Phase 4)
ADMIN_NOTIFY_EMAIL=inforidesaudi@gmail.com
